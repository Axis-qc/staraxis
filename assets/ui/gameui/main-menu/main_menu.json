{
  "schemaVersion": 2,
  "type": "container",
  "name": "root_container",
  "properties": {
    "fillParent": true,
    "backgroundImage": "world/world_bg_1.png"
  },
  "children": [
    {
      "type": "stack",
      "name": "main_menu_stack",
      "properties": {
        "cell": { "expand": true, "fill": true, "grow": true }
      },
      "children": [
        {
          "type": "position",
          "name": "main_panel_pos",
          "properties": {
            "align": "left",
            "pad": 56,
            "width": 520,
            "height": 620
          },
          "children": [
            {
              "type": "container",
              "name": "main_panel",
              "properties": {
                "align": "topleft",
                "pad": 34
              },
              "children": [
                {
                  "type": "vector_label",
                  "effect": "title_hero",
                  "name": "title",
                  "properties": {
                    "text": "app.title",
                    "cell": { "width": 440, "height": 132, "padBottom": 12 }
                  }
                },
                {
                  "type": "vector_image",
                  "name": "title_line",
                  "properties": {
                    "color": "#4AC9FF33",
                    "cell": {
                      "width": 260,
                      "height": 2,
                      "align": "left",
                      "padBottom": 34
                    }
                  }
                },
                {
                  "type": "menu_entry",
                  "effect": "menu_item_primary",
                  "name": "btn_new_game",
                  "properties": {
                    "text": "mainMenu.newGame",
                    "onClick": "NEW_GAME",
                    "cell": { "width": 420, "height": 54, "padBottom": 8 }
                  }
                },
                {
                  "type": "menu_entry",
                  "effect": "menu_item_primary",
                  "name": "btn_load_game",
                  "properties": {
                    "text": "mainMenu.loadGame",
                    "onClick": "LOAD_GAME",
                    "cell": { "width": 420, "height": 54, "padBottom": 8 }
                  }
                },
                {
                  "type": "menu_entry",
                  "effect": "menu_item_secondary",
                  "name": "btn_multiplayer",
                  "properties": {
                    "text": "mainMenu.multiplayer",
                    "tag": "mainMenu.tag.developing",
                    "onClick": "SHOW_DEVELOPING_DIALOG",
                    "cell": { "width": 420, "height": 50, "padBottom": 8 }
                  }
                },
                {
                  "type": "menu_entry",
                  "effect": "menu_item_secondary",
                  "name": "btn_ship_designer",
                  "properties": {
                    "text": "mainMenu.shipDesigner",
                    "tag": "mainMenu.tag.developing",
                    "onClick": "SHOW_DEVELOPING_DIALOG",
                    "cell": { "width": 420, "height": 50, "padBottom": 8 }
                  }
                },
                {
                  "type": "menu_entry",
                  "effect": "menu_item_primary",
                  "name": "btn_settings",
                  "properties": {
                    "text": "mainMenu.settings",
                    "onClick": "OPEN_SETTINGS",
                    "cell": { "width": 420, "height": 54, "padBottom": 8 }
                  }
                },
                {
                  "type": "menu_entry",
                  "effect": "menu_item_secondary",
                  "name": "btn_uitest",
                  "properties": {
                    "text": "UI 测试",
                    "tag": "DEV",
                    "onClick": "OPEN_VECTOR_UI_TEST",
                    "cell": { "width": 420, "height": 50, "padBottom": 8 }
                  }
                },
                {
                  "type": "menu_entry",
                  "effect": "menu_item_secondary",
                  "name": "btn_exit",
                  "properties": {
                    "text": "mainMenu.exit",
                    "onClick": "EXIT_CLICK",
                    "cell": { "width": 420, "height": 50 }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "position",
          "name": "theme_panel_pos",
          "properties": {
            "align": "topright",
            "pad": 36,
            "width": 220,
            "height": 78
          },
          "children": [
            {
              "type": "container",
              "name": "theme_panel",
              "properties": {
                "align": "center",
                "pad": 18
              },
              "children": [
                {
                  "type": "vector_button",
                  "effect": "primary_button",
                  "name": "theme_button",
                  "properties": {
                    "text": "theme.label",
                    "onClick": "TOGGLE_THEME",
                    "cell": { "width": 170, "height": 42 }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "position",
          "name": "version_pos",
          "properties": {
            "align": "bottomright",
            "pad": 28,
            "width": 220,
            "height": 28
          },
          "children": [
            {
              "type": "vector_label",
              "effect": "version_dim",
              "name": "version_info",
              "properties": {
                "text": "common.version"
              }
            }
          ]
        }
      ]
    }
  ]
}
