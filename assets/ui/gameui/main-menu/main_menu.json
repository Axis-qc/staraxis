{
  "schemaVersion": 1,
  "type": "container",
  "name": "root_container",
  "properties": {
    "fillParent": true
  },
  "children": [
    {
      "type": "stack",
      "name": "main_menu_stack",
      "properties": {
        "cell": {
          "expand": true,
          "fill": true
        }
      },
      "children": [
        {
          "type": "container",
          "name": "center_content",
          "properties": {
            "fillParent": true,
            "align": "center",
            "pad": 24
          },
          "children": [
            {
              "type": "label",
              "name": "title",
              "properties": {
                "text": "app.title",
                "alignment": "center",
                "cell": {
                  "padBottom": 18
                }
              }
            },
            {
              "type": "button",
              "name": "btn_new_game",
              "properties": {
                "text": "mainMenu.newGame",
                "onClick": "SHOW_DEVELOPING_DIALOG",
                "cell": {
                  "width": 360,
                  "height": 48,
                  "pad": 8
                }
              }
            },
            {
              "type": "button",
              "name": "btn_load_game",
              "properties": {
                "text": "mainMenu.loadGame",
                "onClick": "SHOW_DEVELOPING_DIALOG",
                "cell": {
                  "width": 360,
                  "height": 48,
                  "pad": 8
                }
              }
            },
            {
              "type": "button",
              "name": "btn_multiplayer",
              "properties": {
                "text": "mainMenu.multiplayer",
                "onClick": "SHOW_DEVELOPING_DIALOG",
                "cell": {
                  "width": 360,
                  "height": 48,
                  "pad": 8
                }
              }
            },
            {
              "type": "button",
              "name": "btn_ship_designer",
              "properties": {
                "text": "mainMenu.shipDesigner",
                "onClick": "SHOW_DEVELOPING_DIALOG",
                "cell": {
                  "width": 360,
                  "height": 48,
                  "pad": 8
                }
              }
            },
            {
              "type": "button",
              "name": "btn_settings",
              "properties": {
                "text": "mainMenu.settings",
                "onClick": "OPEN_SETTINGS",
                "cell": {
                  "width": 360,
                  "height": 48,
                  "pad": 8
                }
              }
            },
            {
              "type": "button",
              "name": "btn_exit",
              "properties": {
                "text": "mainMenu.exit",
                "onClick": "EXIT_CLICK",
                "cell": {
                  "width": 360,
                  "height": 48,
                  "pad": 8
                }
              }
            }
          ]
        },
        {
          "type": "container",
          "name": "top_right_overlay",
          "properties": {
            "fillParent": true,
            "align": "topright",
            "pad": 8
          },
          "children": [
            {
              "type": "container",
              "name": "lang_group",
              "properties": {
                "align": "topright",
                "pad": 0
              },
              "children": [
                {
                  "type": "button",
                  "name": "lang_button",
                  "properties": {
                    "text": "lang.current",
                    "onClick": "TOGGLE_LANGUAGE_MENU",
                    "cell": {
                      "width": 140,
                      "height": 40,
                      "pad": 4
                    }
                  }
                },
                {
                  "type": "container",
                  "name": "lang_menu",
                  "properties": {
                    "visible": false,
                    "align": "topright",
                    "pad": 0,
                    "cell": {
                      "padTop": 4
                    }
                  },
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}