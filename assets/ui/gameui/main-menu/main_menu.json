{
  "schemaVersion": 2,
  "type": "container",
  "name": "root_container",
  "properties": {
    "fillParent": true
  },
  "children": [
    {
      "type": "stack",
      "name": "main_menu_stack",
      "children": [
        {
          "type": "container",
          "name": "hud",
          "properties": {
            "fillParent": true,
            "align": "left",
            "pad": 48
          },
          "children": [
            {
              "type": "container",
              "name": "hud_content",
              "properties": {
                "align": "topleft",
                "cell": { "expand": true, "fillY": true }
              },
              "children": [
                {
                  "type": "vector_label",
                  "effect": "title_white",
                  "name": "title",
                  "properties": {
                    "text": "app.title",
                    "cell": { "width": 400, "height": 56, "padBottom": 4 }
                  }
                },
                {
                  "type": "vector_label",
                  "effect": "subtitle_accent",
                  "name": "subtitle",
                  "properties": {
                    "text": "mainMenu.web.subtitle",
                    "cell": { "width": 400, "height": 24, "padBottom": 32 }
                  }
                },
                {
                  "type": "menu_entry",
                  "effect": "menu_item_primary",
                  "name": "btn_new_game",
                  "properties": {
                    "text": "mainMenu.newGame",
                    "onClick": "NEW_GAME",
                    "cell": { "width": 360, "height": 48, "padBottom": 8 }
                  }
                },
                {
                  "type": "menu_entry",
                  "effect": "menu_item_primary",
                  "name": "btn_load_game",
                  "properties": {
                    "text": "mainMenu.loadGame",
                    "onClick": "LOAD_GAME",
                    "cell": { "width": 360, "height": 48, "padBottom": 8 }
                  }
                },
                {
                  "type": "menu_entry",
                  "effect": "menu_item_secondary",
                  "name": "btn_multiplayer",
                  "properties": {
                    "text": "mainMenu.multiplayer",
                    "tag": "mainMenu.tag.developing",
                    "onClick": "SHOW_DEVELOPING_DIALOG",
                    "cell": { "width": 360, "height": 48, "padBottom": 8 }
                  }
                },
                {
                  "type": "menu_entry",
                  "effect": "menu_item_secondary",
                  "name": "btn_ship_designer",
                  "properties": {
                    "text": "mainMenu.shipDesigner",
                    "tag": "mainMenu.tag.developing",
                    "onClick": "SHOW_DEVELOPING_DIALOG",
                    "cell": { "width": 360, "height": 48, "padBottom": 8 }
                  }
                },
                {
                  "type": "menu_entry",
                  "effect": "menu_item_primary",
                  "name": "btn_settings",
                  "properties": {
                    "text": "mainMenu.settings",
                    "onClick": "OPEN_SETTINGS",
                    "cell": { "width": 360, "height": 48, "padBottom": 8 }
                  }
                },
                {
                  "type": "menu_entry",
                  "effect": "menu_item_primary",
                  "name": "btn_exit",
                  "properties": {
                    "text": "mainMenu.exit",
                    "onClick": "EXIT_CLICK",
                    "cell": { "width": 360, "height": 48 }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "position",
          "name": "lang_button_pos",
          "properties": {
            "align": "topright",
            "pad": 8
          },
          "children": [
            {
              "type": "container",
              "name": "top_right_buttons",
              "properties": {
                "align": "topright"
              },
              "children": [
                {
                  "type": "vector_button",
                  "effect": "primary_button",
                  "name": "lang_button",
                  "properties": {
                    "text": "lang.current",
                    "onClick": "TOGGLE_LANGUAGE",
                    "cell": { "width": 140, "height": 36, "padBottom": 6 }
                  }
                },
                {
                  "type": "vector_button",
                  "effect": "primary_button",
                  "name": "theme_button",
                  "properties": {
                    "text": "theme.current",
                    "onClick": "TOGGLE_THEME",
                    "cell": { "width": 140, "height": 36 }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "position",
          "name": "version_pos",
          "properties": {
            "align": "bottomright",
            "pad": 24,
            "width": 200,
            "height": 20
          },
          "children": [
            {
              "type": "vector_label",
              "effect": "version_dim",
              "name": "version_info",
              "properties": {
                "text": "common.version"
              }
            }
          ]
        }
      ]
    }
  ]
}
