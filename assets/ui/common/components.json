{
  "btn-small": {
    "type": "vector_button",
    "properties": {
      "class": "btn-small",
      "text": "${text}",
      "onClick": "${onClick}"
    }
  },
  "divider": {
    "type": "vector_image",
    "properties": {
      "color": "#4AC9FF22",
      "cell": {
        "height": 2
      }
    }
  },
  "divider-vert": {
    "type": "vector_image",
    "properties": {
      "color": "#4AC9FF22",
      "cell": {
        "width": 2
      }
    }
  },
  "panel-rounded": {
    "type": "container",
    "properties": {
      "pad": 14
    },
    "children": []
  },
  "row": {
    "type": "container",
    "properties": {
      "layout": "row"
    },
    "children": []
  },
  "scroll-vert": {
    "type": "vector_scrollpane",
    "properties": {
      "scrollX": false,
      "scrollY": true
    },
    "children": [
      {
        "type": "container",
        "children": []
      }
    ]
  }
}