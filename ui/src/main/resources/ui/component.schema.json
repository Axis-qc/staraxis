{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UI Component Schema",
  "description": "Schema for defining a UI component in JSON.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "description": "Version of the component schema used by this JSON file.",
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "description": "The type of the component.",
      "type": "string",
      "enum": [
        "container",
        "stack",
        "scroll",
        "window",
        "dialog",
        "verticalGroup",
        "repeat",
        "position",
        "label",
        "button",
        "image",
        "slider",
        "progressBar",
        "textField",
        "selectBox",
        "checkBox",
        "horizontalGroup",
        "imageButton",
        "textButton",
        "menu_entry",
        "vector_button",
        "vector_label",
        "starfield"
      ]
    },
    "name": {
      "description": "A unique identifier for the component.",
      "type": "string"
    },
    "effect": {
      "description": "Reference an effect from ui/effects/default.json.",
      "type": "string"
    },
    "tag": {
      "description": "Tag text key for components like menu_entry.",
      "type": "string"
    },
    "onClick": {
      "description": "Action id dispatched on click.",
      "type": "string"
    },
    "dataSource": {
      "description": "Data source name for repeat components.",
      "type": "string"
    },
    "properties": {
      "description": "Component-specific properties.",
      "type": "object"
    },
    "children": {
      "description": "An array of child components.",
      "type": "array",
      "items": {
        "$ref": "#"
      }
    },
    "include": {
      "description": "Reference a component template from ui/common/components.json",
      "type": "string"
    },
    "ref": {
      "description": "Reference an external UI JSON file to inline at this position.",
      "type": "string"
    },
    "params": {
      "description": "Parameters for include template substitution",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "required": ["type"]
    },
    {
      "required": ["include"]
    },
    {
      "required": ["ref"]
    }
  ]
}
