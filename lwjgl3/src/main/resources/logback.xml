<configuration>
    <!-- 与 GameLog/WebNetLog 等一致：日志写到当前工作目录下的 gamedata/logs，
         禁止使用 ../ 跳转，避免开发运行时把日志写到项目目录外。 -->
    <property name="LOG_DIR" value="${user.dir}/gamedata/logs"/>

    <!-- NOTE: 启动时覆盖旧日志，避免历史错误堆积影响排查；按需可改回 Rolling 策略。 -->

    <appender name="GAME" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_DIR}/game.log</file>
        <append>false</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} | %-5level | %logger{36} | %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="ERROR" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_DIR}/error.log</file>
        <append>false</append>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} | %-5level | %logger{36} | %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="GAME"/>
        <appender-ref ref="ERROR"/>
    </root>
</configuration>
